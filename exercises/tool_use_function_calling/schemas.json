{
  "get_weather": {
    "required": [
      "city"
    ],
    "properties": {
      "city": {
        "type": "string"
      },
      "units": {
        "type": "string",
        "enum": [
          "c",
          "f"
        ]
      }
    }
  },
  "add_task": {
    "required": [
      "title"
    ],
    "properties": {
      "title": {
        "type": "string"
      },
      "priority": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "done": {
        "type": "boolean"
      }
    }
  },
  "convert_currency": {
    "required": [
      "amount",
      "from",
      "to"
    ],
    "properties": {
      "amount": {
        "type": "number",
        "minimum": 0
      },
      "from": {
        "type": "string",
        "enum": [
          "USD",
          "EUR",
          "RUB"
        ]
      },
      "to": {
        "type": "string",
        "enum": [
          "USD",
          "EUR",
          "RUB"
        ]
      }
    }
  }
}
